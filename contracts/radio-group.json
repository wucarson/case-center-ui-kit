{
  "$schema": "./contract.schema.json",
  "name": "radio-group",
  "title": "單選",
  "tier": "logic",
  "logic": "core/choice.ts",
  "description": "2–5 個互斥選項、選項都看得到。",
  "use": "選項少、需要同時看到所有選項時。",
  "instead": [
    { "when": "選項超過 5 個", "use": "combo" },
    { "when": "切換檢視或篩選，選項很短", "use": "segmented" }
  ],
  "form": { "value": "string", "prop": "value" },
  "parts": [
    { "name": "group", "selector": "[role=\"radiogroup\"]", "element": "div", "classes": { "rads": "選項清單" }, "attrs": { "aria-label": {} } },
    {
      "name": "radio",
      "selector": ".rad",
      "element": "div",
      "classes": { "rad": "選項", "on": "選中", "tall": "有說明（兩行）", "dis": "停用" },
      "attrs": {
        "role": { "values": ["radio"], "required": true },
        "aria-checked": { "values": ["true", "false"], "required": true },
        "tabindex": { "values": ["0", "-1"], "required": true },
        "aria-disabled": { "values": ["true"] }
      },
      "sync": [
        { "class": "on", "attr": "aria-checked", "value": "true" },
        { "class": "dis", "attr": "aria-disabled", "value": "true" }
      ]
    },
    { "name": "dot", "selector": ".rad > i", "element": "i", "classes": { "is-focus": "鍵盤聚焦時的焦點框" } }
  ],
  "keyboard": [
    { "keys": "↑、↓、←、→", "action": "移到上一個、下一個並選取（跳過停用項，循環）" },
    { "keys": "Space、Enter", "action": "選取" }
  ],
  "example": "<div role=\"radiogroup\" class=\"rads\" aria-label=\"分組方式\"><div role=\"radio\" aria-checked=\"true\" tabindex=\"0\" class=\"rad on\"><i></i>依部門</div><div role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" class=\"rad\"><i></i>依專案</div></div>"
}
