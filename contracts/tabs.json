{
  "$schema": "./contract.schema.json",
  "name": "tabs",
  "title": "頁籤",
  "tier": "logic",
  "logic": "core/tabs.ts",
  "description": "同一頁內切換平行內容，可帶數量。",
  "use": "列表的篩選分類，例：全部、待處理、提及。",
  "instead": [{ "when": "專案、案件詳情頁的主要分區", "use": "detail-tabs" }],
  "parts": [
    { "name": "root", "selector": ".tabs", "element": "div", "classes": { "tabs": "頁籤列" }, "attrs": { "role": { "values": ["tablist"], "required": true }, "aria-label": {} } },
    {
      "name": "tab",
      "selector": ".tabs > .tab",
      "element": "span",
      "classes": { "tab": "頁籤", "on": "選中" },
      "attrs": {
        "role": { "values": ["tab"], "required": true },
        "aria-selected": { "values": ["true", "false"], "required": true },
        "tabindex": { "values": ["0", "-1"], "required": true }
      },
      "sync": [
        { "class": "on", "attr": "aria-selected", "value": "true" },
        { "class": "on", "attr": "tabindex", "value": "0" }
      ]
    },
    { "name": "count", "selector": ".tab > b", "element": "b", "classes": {} }
  ],
  "keyboard": [
    { "keys": "←、→", "action": "選上一個、下一個（循環）" },
    { "keys": "Home、End", "action": "選第一個、最後一個" }
  ],
  "example": "<div class=\"tabs\" role=\"tablist\" aria-label=\"篩選\"><span class=\"tab on\" role=\"tab\" aria-selected=\"true\" tabindex=\"0\">全部</span><span class=\"tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">待處理<b>12</b></span></div>"
}
