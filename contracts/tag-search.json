{
  "$schema": "./contract.schema.json",
  "name": "tag-search",
  "title": "搜尋與標籤建議",
  "tier": "logic",
  "logic": "core/search.ts",
  "description": "邊打字邊列出相符的標籤，可直接選建議。沒有相符的標籤就不顯示清單。",
  "use": "公告、知識庫的標題與標籤搜尋。",
  "instead": [{ "when": "結構化篩選（部門、狀態）", "use": "combo" }],
  "form": { "value": "string", "prop": "value", "empty": "" },
  "parts": [
    { "name": "root", "selector": ".tsr", "element": "div", "classes": { "tsr": "搜尋與建議" } },
    { "name": "box", "selector": ".tsr > .search", "element": "div", "classes": { "search": "搜尋框", "focus": "聚焦中" } },
    {
      "name": "input",
      "selector": ".search > input",
      "element": "input",
      "classes": { "ff-real": "原生輸入框" },
      "attrs": {
        "role": { "values": ["combobox"], "required": true },
        "aria-label": { "required": true },
        "aria-expanded": { "values": ["true", "false"], "required": true },
        "aria-autocomplete": { "values": ["list"], "required": true },
        "aria-controls": { "required": true }
      }
    },
    { "name": "list", "selector": ".tsr > .results", "element": "div", "classes": { "results": "建議清單", "show": "顯示中" }, "attrs": { "role": { "values": ["listbox"], "required": true }, "aria-label": { "required": true } } },
    {
      "name": "option",
      "selector": ".results > .res",
      "element": "div",
      "classes": { "res": "建議", "hl": "目前停留（Enter 會選它）" },
      "attrs": { "role": { "values": ["option"], "required": true }, "aria-selected": { "values": ["true", "false"], "required": true } },
      "sync": [{ "class": "hl", "attr": "aria-selected", "value": "true" }]
    }
  ],
  "keyboard": [
    { "keys": "↑、↓", "action": "在建議間移動（頭尾相接）" },
    { "keys": "Enter", "action": "選取建議" },
    { "keys": "Esc", "action": "收起建議" }
  ],
  "example": "<div class=\"tsr\"><div class=\"search focus\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">…</svg><input class=\"ff-real\" role=\"combobox\" aria-label=\"搜尋公告\" aria-expanded=\"true\" aria-controls=\"q-list\" aria-autocomplete=\"list\"></div><div class=\"results show\" id=\"q-list\" role=\"listbox\" aria-label=\"搜尋公告的標籤建議\"><div class=\"res hl\" role=\"option\" aria-selected=\"true\"><span>系統維護</span><em>8 篇</em></div></div></div>"
}
