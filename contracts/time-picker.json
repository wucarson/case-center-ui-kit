{
  "$schema": "./contract.schema.json",
  "name": "time-picker",
  "title": "時間選擇",
  "tier": "logic",
  "logic": "core/time.ts",
  "description": "時、分各自上下調（各自循環，不互相進位）。",
  "use": "選一個時間點，例：開始時間、提醒時間。",
  "instead": [{ "when": "要選一段期間", "use": "period-picker" }],
  "form": { "value": "string", "prop": "value", "format": "HH:mm", "empty": "00:00" },
  "parts": [
    { "name": "root", "selector": ".tp", "element": "div", "classes": { "tp": "時間選擇", "dis": "停用：同表單欄位停用，不能操作" }, "attrs": { "role": { "values": ["group"], "required": true }, "aria-label": { "required": true }, "aria-disabled": { "values": ["true"] } }, "sync": [{ "class": "dis", "attr": "aria-disabled", "value": "true" }] },
    { "name": "field", "selector": ".tp > .tp-f", "element": "div", "classes": { "tp-f": "目前值" }, "attrs": { "aria-hidden": { "values": ["true"], "required": true } } },
    { "name": "columns", "selector": ".tp > .tp-c", "element": "div", "classes": { "tp-c": "時、分欄" } },
    { "name": "column", "selector": ".tp-c > .tp-col", "element": "div", "classes": { "tp-col": "一欄" } },
    {
      "name": "step",
      "selector": ".tp-col > u",
      "element": "u",
      "classes": {},
      "attrs": { "role": { "values": ["button"], "required": true }, "tabindex": { "values": ["-1"], "required": true }, "aria-label": { "required": true } }
    },
    {
      "name": "value",
      "selector": ".tp-col > .v",
      "element": "span",
      "classes": { "v": "數值格" },
      "attrs": {
        "role": { "values": ["spinbutton"], "required": true },
        "tabindex": { "values": ["0", "-1"], "required": true },
        "aria-label": { "required": true },
        "aria-valuenow": { "required": true },
        "aria-valuemin": { "values": ["0"], "required": true },
        "aria-valuemax": { "values": ["23", "59"], "required": true }
      }
    }
  ],
  "keyboard": [{ "keys": "↑、↓", "action": "在數值格上加一、減一（分鐘依 step）" }],
  "example": "<div class=\"tp\" role=\"group\" aria-label=\"開始時間\">…<span class=\"v\" role=\"spinbutton\" tabindex=\"0\" aria-label=\"時\" aria-valuenow=\"9\" aria-valuemin=\"0\" aria-valuemax=\"23\">…</span>…</div>"
}
