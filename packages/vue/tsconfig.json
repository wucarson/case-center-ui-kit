{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "declaration": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
